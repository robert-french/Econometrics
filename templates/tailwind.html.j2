<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- EDIT THIS -->
  <title>Econometrics</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-50 text-slate-900 font-sans">

  <span id="top"></span>

  <!-- Faint LMU shield watermark behind page content -->
  <div
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 -z-10 flex items-center justify-center"
  >
    <img
      src="LMU_SquareOrig.png"
      alt=""
      class="w-[640px] max-w-[80vw] opacity-[0.06]"
    />
  </div>

  <!-- ========================================================= -->
  <!-- BACK TO TOP                                               -->
  <!-- Fixed at the top of the screen, fades in once you scroll  -->
  <!-- ========================================================= -->

  <a
    id="back-to-top"
    href="#top"
    class="fixed top-4 left-1/2 -translate-x-1/2 z-50 rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 hover:bg-slate-700"
  >
    &uarr; Back to top
  </a>

  <main class="relative max-w-6xl mx-auto px-6 py-12">

    <!-- ========================================================= -->
    <!-- HEADER                                                    -->
    <!-- Title on the left, section links along the top right      -->
    <!-- ========================================================= -->

    <header class="mb-16">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold tracking-wide uppercase text-slate-500">
            ECON 3300
          </p>

          <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight">
            Econometrics
          </h1>
        </div>

        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-600 sm:pb-2 sm:pr-4">
          <a href="#lectures" class="hover:text-slate-900">Lectures</a>
          <a href="#for-students" class="hover:text-slate-900">For students</a>
          <a href="#for-educators" class="hover:text-slate-900">For educators</a>
        </nav>
      </div>
    </header>


    <!-- ========================================================= -->
    <!-- COURSE DESCRIPTION                                        -->
    <!-- First section, no nav link, edit this freely              -->
    <!-- ========================================================= -->

    <section class="mb-20 max-w-3xl">
      <p class="text-lg leading-8 text-slate-600">
        This website is in development. Check back later for lecture notebooks and resources for ECON 3300!
      </p>
    </section>


    <!-- ========================================================= -->
    <!-- LECTURES                                                  -->
    <!-- Cards are generated automatically from your notebooks     -->
    <!-- ========================================================= -->

    <section id="lectures" class="scroll-mt-20 mb-20">

      <h2 class="text-2xl font-semibold mb-2">
        Lectures
      </h2>

      <p class="mb-6 text-slate-600">
        Open a lecture to read it in your browser.
      </p>

      {% if apps %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        {% for app in apps %}
          <article class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">

            <p class="text-sm font-medium text-slate-500 mb-2">
              Lecture
            </p>

            <h3 class="text-xl font-semibold leading-snug">
              {{ app.display_name }}
            </h3>

            <p class="mt-3 text-slate-600 leading-7">
              {{ app.description or "Open the lecture to read it in your browser." }}
            </p>

            <div class="mt-6">
              <a
                href="{{ app.html_path }}"
                class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
              >
                Open lecture
              </a>
            </div>

          </article>
        {% endfor %}

      </div>
      {% elif notebooks %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        {% for notebook in notebooks %}
        <article class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">

          <h3 class="text-xl font-semibold leading-snug">
            {{ notebook.display_name }}
          </h3>

          <p class="mt-3 text-slate-600 leading-7">
            {{ notebook.description or "Open the lecture to read it in your browser." }}
          </p>

          <div class="mt-6">
            <a
              href="{{ notebook.html_path }}"
              class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
            >
              Open lecture
            </a>
          </div>

        </article>
        {% endfor %}

      </div>
      {% else %}
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
        <h3 class="text-xl font-semibold">
          No lectures found
        </h3>

        <p class="mt-3 text-slate-600">
          Add marimo notebooks to the notebooks folder, then push your changes to GitHub.
        </p>
      </div>
      {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- FOR STUDENTS                                              -->
    <!-- Edit this section freely                                  -->
    <!-- ========================================================= -->

    <section id="for-students" class="scroll-mt-20 mb-20 max-w-3xl">
      <h2 class="text-2xl font-semibold mb-4">
        For students
      </h2>

      <p class="text-slate-600 leading-8">
        Resources and instructions for students will go here.
      </p>
    </section>


    <!-- ========================================================= -->
    <!-- FOR EDUCATORS                                             -->
    <!-- Edit this section freely                                  -->
    <!-- ========================================================= -->

    <section id="for-educators" class="scroll-mt-20 mb-20 max-w-3xl">
      <h2 class="text-2xl font-semibold mb-4">
        For educators
      </h2>

      <p class="text-slate-600 leading-8">
        Notes for educators who want to reuse or adapt these materials will go here.
      </p>
    </section>


    <!-- ========================================================= -->
    <!-- FOOTER                                                    -->
    <!-- Edit this section to change the bottom of the website      -->
    <!-- ========================================================= -->

    <footer class="mt-16 pt-8 border-t border-slate-200 text-sm text-slate-500">
      <p>
        Built with marimo notebooks and GitHub Pages.
      </p>
    </footer>

  </main>

  <script>
    // Show the "Back to top" link only after the reader scrolls down.
    (function () {
      var btt = document.getElementById("back-to-top");
      if (!btt) return;
      function update() {
        if (window.scrollY > 400) {
          btt.classList.remove("opacity-0", "pointer-events-none");
        } else {
          btt.classList.add("opacity-0", "pointer-events-none");
        }
      }
      window.addEventListener("scroll", update, { passive: true });
      update();
    })();
  </script>

</body>
</html>
