    <!-- Dummy element so the Tailwind CDN compiles the classes the tab
         script toggles at runtime. -->
    <span class="hidden underline decoration-2 underline-offset-8 text-[#3b82f6]"></span>


    <!-- ========================================================= -->
    <!-- LECTURES (tab panel)                                      -->
    <!-- Cards are generated automatically from your notebooks     -->
    <!-- and grouped by theme in build.py's LECTURE_GROUPS.        -->
    <!-- ========================================================= -->

    <section id="lectures" class="tab-panel scroll-mt-20 mb-20 hidden">

      <p class="mb-6 text-slate-600">
        Lecture notebooks are released at least two days before we cover the material in class. 
      </p>

      {% if lecture_groups %}
      <div id="lecture-groups" class="space-y-1">
        {% for group in lecture_groups %}
        <details class="group" name="lecture-groups">
          <summary class="group/row flex cursor-pointer items-center gap-2 py-2 list-none [&::-webkit-details-marker]:hidden">
            <svg
              class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-90 group-hover/row:text-[#3b82f6]"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
            <h3 class="text-lg font-semibold group-hover/row:text-[#3b82f6]">{{ group.title }}</h3>
            {% if group.range_label %}
            <p class="text-sm text-slate-500">{{ group.range_label }}</p>
            {% endif %}
          </summary>
          <div class="pb-5 pl-6 pt-3">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {% for item in group['items'] %}
              {{ card(item, 'Lecture', 'Open lecture', 'Open the lecture to read it in your browser.', disabled=item.preliminary) }}
              {% endfor %}
            </div>
          </div>
        </details>
        {% endfor %}
      </div>
      {% else %}
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
        <h3 class="text-xl font-semibold">
          No lectures found
        </h3>

        <p class="mt-3 text-slate-600">
          Add marimo notebooks to the notebooks folder, then push your changes to GitHub.
        </p>
      </div>
      {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- PROBLEM SET SOLUTIONS (tab panel)                         -->
    <!-- Cards come from notebooks named PS<N>...py                -->
    <!-- ========================================================= -->

    <section id="problem-sets" class="tab-panel scroll-mt-20 mb-20 hidden">

      <p class="mb-6 text-slate-600">
        Problem sets are handed out in class on Tuesdays. Solutions are posted here and on Brightspace the following Tuesday evening, after you have submitted the problem set in class.
      </p>

      {% if problem_sets %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for item in problem_sets %}
        {{ card(item, 'Problem Set', 'Open problem set', 'Open the problem set to read it in your browser.', disabled=item.preliminary) }}
        {% endfor %}
      </div>
      {% else %}
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
        <h3 class="text-xl font-semibold">
          Coming soon
        </h3>

        <p class="mt-3 text-slate-600">
          Problem set solutions will appear here as they are posted.
        </p>
      </div>
      {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- STATA TUTORIALS (tab panel)                               -->
    <!-- Cards come from notebooks named Stata<N>...py             -->
    <!-- ========================================================= -->

    <section id="stata-tutorials" class="tab-panel scroll-mt-20 mb-20 hidden">

      <p class="mb-6 text-slate-600">
        Stata tutorials are released at least two days before we cover the material in class.
      </p>

      {% if stata_tutorials %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for item in stata_tutorials %}
        {{ card(item, 'Stata Tutorial', 'Open tutorial', 'Open the tutorial to read it in your browser.', disabled=item.preliminary) }}
        {% endfor %}
      </div>
      {% else %}
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
        <h3 class="text-xl font-semibold">
          Coming soon
        </h3>

        <p class="mt-3 text-slate-600">
          Stata tutorials will appear here as they are posted.
        </p>
      </div>
      {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- FOR EDUCATORS (home view only)                            -->
    <!-- Edit this section freely                                  -->
    <!-- ========================================================= -->

    <section id="for-educators" class="home-only scroll-mt-20 mb-20 max-w-3xl">
      <h2 class="text-2xl font-semibold mb-4">
        For educators
      </h2>

      <p class="text-slate-600 leading-8">
        If you are an educator interested in creating interactive course lecture notes like those
        on this website, please feel free to reach out. I&rsquo;d be happy to share the underlying
        repository or offer guidance on creating your own materials, with appropriate attribution.
        You can contact me at
        <a href="mailto:robert.french@lmu.edu" class="font-medium text-[#3b82f6] hover:underline">robert.french@lmu.edu</a>.
      </p>
    </section>


    <!-- ========================================================= -->
    <!-- FOOTER                                                    -->
    <!-- Edit this section to change the bottom of the website      -->
    <!-- ========================================================= -->

    <footer class="mt-16 pt-8 border-t border-slate-200 text-sm text-slate-500">
      <p>
        Built with marimo notebooks and GitHub Pages.
      </p>
    </footer>

  </main>

  <script>
    // Show the "Back to top" link only after the reader scrolls down.
    (function () {
      var btt = document.getElementById("back-to-top");
      if (!btt) return;
      function update() {
        if (window.scrollY > 120) {
          btt.classList.remove("opacity-0", "pointer-events-none");
        } else {
          btt.classList.add("opacity-0", "pointer-events-none");
        }
      }
      window.addEventListener("scroll", update, { passive: true });
      update();
    })();

    // Banner tabs: on load the home view (course description, For students,
    // For educators) is shown and every panel is hidden. Selecting a banner
    // link replaces the home view with that panel alone; clicking the active
    // link again returns to the home view. The URL hash mirrors the open
    // panel so deep links work.
    (function () {
      var TAB_IDS = ["lectures", "problem-sets", "stata-tutorials"];
      var ACTIVE = ["underline", "decoration-2", "underline-offset-8", "text-[#3b82f6]"];
      var current = null;

      function setTab(id) {
        current = id;
        TAB_IDS.forEach(function (tabId) {
          var panel = document.getElementById(tabId);
          var link = document.querySelector('[data-tab-link="' + tabId + '"]');
          var active = tabId === id;
          if (panel) panel.classList.toggle("hidden", !active);
          if (link) {
            ACTIVE.forEach(function (cls) {
              link.classList.toggle(cls, active);
            });
          }
        });
        document.querySelectorAll(".home-only").forEach(function (el) {
          el.classList.toggle("hidden", id !== null);
        });
      }

      function openFromHash() {
        var id = window.location.hash.replace("#", "");
        if (TAB_IDS.indexOf(id) !== -1) setTab(id);
      }

      document.querySelectorAll("[data-tab-link]").forEach(function (link) {
        link.addEventListener("click", function (event) {
          event.preventDefault();
          var id = link.getAttribute("data-tab-link");
          if (current === id) {
            setTab(null);
            history.replaceState(null, "", window.location.pathname + window.location.search);
          } else {
            setTab(id);
            history.replaceState(null, "", "#" + id);
          }
        });
      });

      // The "ECON 3300 / Econometrics" header is a link back to the home
      // view: close any open panel without reloading the page.
      document.querySelectorAll("[data-home-link]").forEach(function (link) {
        link.addEventListener("click", function (event) {
          event.preventDefault();
          setTab(null);
          history.replaceState(null, "", window.location.pathname + window.location.search);
          window.scrollTo({ top: 0 });
        });
      });

      window.addEventListener("hashchange", openFromHash);
      openFromHash();
    })();

    // Exclusive accordions (Course Expectations, lecture groups): opening one
    // <details> closes the others in the same box. Modern browsers do this
    // natively via the shared name="..." attribute; this fallback covers
    // older browsers that ignore it.
    (function () {
      var ids = ["course-expectations", "lecture-groups"];
      for (var k = 0; k < ids.length; k++) {
        var box = document.getElementById(ids[k]);
        if (!box) continue;
        box.addEventListener("toggle", function (e) {
          var opened = e.target;
          var wrap = e.currentTarget;
          if (!opened.open || opened.parentNode !== wrap) return;
          var all = wrap.querySelectorAll("details");
          for (var i = 0; i < all.length; i++) {
            if (all[i] !== opened && all[i].open) all[i].open = false;
          }
        }, true);
      }
    })();
  </script>

</body>
</html>
