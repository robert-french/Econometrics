      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <a href="./" data-home-link class="block">
          <p class="text-sm font-semibold tracking-wide uppercase text-slate-500">
            ECON 3300, Prof. French
          </p>

          <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight">
            Econometrics
          </h1>
        </a>

        <nav class="flex flex-wrap gap-x-7 gap-y-2 text-lg font-semibold text-slate-900 sm:pb-2 sm:pr-4">
          <a href="#lectures" data-tab-link="lectures" class="hover:text-[#3b82f6]">Lectures</a>
          <a href="#problem-sets" data-tab-link="problem-sets" class="hover:text-[#3b82f6]">Problem sets</a>
          <a href="#stata-tutorials" data-tab-link="stata-tutorials" class="hover:text-[#3b82f6]">Stata tutorials</a>
