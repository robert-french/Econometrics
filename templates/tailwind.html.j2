{#
  Card used by all three tabs. `item` is one notebook dict from build.py;
  the eyebrow label comes from splitting the app_title at the first ": "
  (e.g. "Lecture 15: Panel Data I" -> "Lecture 15" / "Panel Data I").
#}
{% macro card(item, fallback_label, button_text, blurb_fallback, disabled=false) %}
  {% set _parts = item.display_name.split(': ', 1) %}
  {% set _label = _parts[0] if _parts|length == 2 else fallback_label %}
  {% set _topic = _parts[1] if _parts|length == 2 else item.display_name %}
  <article class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">

    <div class="flex items-center justify-between gap-2 mb-2">
      <p class="text-sm font-medium text-slate-500">
        {{ _label }}
      </p>
      {% if item.preliminary %}
      <span class="inline-flex items-center rounded-full bg-red-100 text-red-800 text-xs font-semibold px-2.5 py-0.5">
        Coming soon
      </span>
      {% endif %}
    </div>

    <h3 class="text-xl font-semibold leading-snug min-h-[3.4375rem] flex items-center">
      {{ _topic }}
    </h3>

    <p class="mt-3 text-slate-600 leading-7 line-clamp-2">
      {{ item.description or item.key_terms or blurb_fallback }}
    </p>

    <div class="mt-6">
      {% if disabled %}
      <span
        aria-disabled="true"
        class="inline-flex items-center rounded-lg bg-slate-200 px-4 py-2 text-sm font-medium text-slate-400 cursor-not-allowed select-none"
      >
        {{ button_text }}
      </span>
      {% else %}
      <a
        href="{{ item.html_path }}"
        class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
      >
        {{ button_text }}
      </a>
      {% endif %}
    </div>

  </article>
{% endmacro %}

<body class="relative bg-slate-50 text-slate-900 font-sans">

  <span id="top"></span>

  <!-- Faint LMU shield watermark behind page content.
       Anchored to the top of the page (not the viewport), so it scrolls
