<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- EDIT THIS -->
  <title>Econometrics</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

{#
  Card used by all three tabs. `item` is one notebook dict from build.py;
  the eyebrow label comes from splitting the app_title at the first ": "
  (e.g. "Lecture 15: Panel Data I" -> "Lecture 15" / "Panel Data I").
#}
{% macro card(item, fallback_label, button_text, blurb_fallback) %}
  {% set _parts = item.display_name.split(': ', 1) %}
  {% set _label = _parts[0] if _parts|length == 2 else fallback_label %}
  {% set _topic = _parts[1] if _parts|length == 2 else item.display_name %}
  <article class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">

    <div class="flex items-center justify-between gap-2 mb-2">
      <p class="text-sm font-medium text-slate-500">
        {{ _label }}
      </p>
      {% if item.preliminary %}
      <span class="inline-flex items-center rounded-full bg-amber-100 text-amber-800 text-xs font-semibold px-2.5 py-0.5">
        Preliminary
      </span>
      {% endif %}
    </div>

    <h3 class="text-xl font-semibold leading-snug min-h-[3.4375rem] flex items-center">
      {{ _topic }}
    </h3>

    <p class="mt-3 text-slate-600 leading-7 line-clamp-2">
      {{ item.description or item.key_terms or blurb_fallback }}
    </p>

    <div class="mt-6">
      <a
        href="{{ item.html_path }}"
        class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
      >
        {{ button_text }}
      </a>
    </div>

  </article>
{% endmacro %}

<body class="bg-slate-50 text-slate-900 font-sans">

  <span id="top"></span>

  <!-- Faint LMU shield watermark behind page content -->
  <div
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 -z-10 flex items-center justify-center"
  >
    <img
      src="LMU_SquareOrig.png"
      alt=""
      class="w-[640px] max-w-[80vw] opacity-[0.10]"
    />
  </div>

  <!-- ========================================================= -->
  <!-- BACK TO TOP                                               -->
  <!-- Fixed at the top of the screen, fades in once you scroll  -->
  <!-- ========================================================= -->

  <a
    id="back-to-top"
    href="#top"
    class="fixed top-4 left-1/2 -translate-x-1/2 z-50 rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 hover:bg-slate-700"
  >
    &uarr; Back to top
  </a>

  <main class="relative max-w-6xl mx-auto px-6 py-12">

    <!-- ========================================================= -->
    <!-- HEADER                                                    -->
    <!-- Title on the left, section links along the top right      -->
    <!-- ========================================================= -->

    <header class="mb-16">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold tracking-wide uppercase text-slate-500">
            ECON 3300
          </p>

          <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight">
            Econometrics
          </h1>
        </div>

        <nav class="flex flex-wrap gap-x-7 gap-y-2 text-lg font-semibold text-[#1f4e79] sm:pb-2 sm:pr-4">
          <a href="#lectures" data-tab-link="lectures" class="hover:text-[#15324f]">Lectures</a>
          <a href="#problem-set-solutions" data-tab-link="problem-set-solutions" class="hover:text-[#15324f]">Problem set solutions</a>
          <a href="#stata-tutorials" data-tab-link="stata-tutorials" class="hover:text-[#15324f]">Stata tutorials</a>
        </nav>
      </div>
    </header>


    <!-- ========================================================= -->
    <!-- COURSE DESCRIPTION (home view only)                       -->
    <!-- Shown when no banner tab is selected; edit this freely.   -->
    <!-- Selecting a banner link hides every .home-only section    -->
    <!-- and shows just that panel; clicking the active link again -->
    <!-- returns to this home view.                                -->
    <!-- ========================================================= -->

    <section class="home-only mb-12 max-w-3xl">
      <p class="text-lg leading-8 text-slate-600">
        This website is in development. Check back later for lecture notebooks and resources for ECON 3300!
      </p>
    </section>

    <!-- Dummy element so the Tailwind CDN compiles the classes the tab
         script toggles at runtime. -->
    <span class="hidden underline decoration-2 underline-offset-8 text-[#15324f]"></span>


    <!-- ========================================================= -->
    <!-- LECTURES (tab panel)                                      -->
    <!-- Cards are generated automatically from your notebooks     -->
    <!-- and grouped by theme in build.py's LECTURE_GROUPS.        -->
    <!-- ========================================================= -->

    <section id="lectures" class="tab-panel scroll-mt-20 mb-20 hidden">

      <h2 class="text-2xl font-semibold mb-2">
        Lectures
      </h2>

      <p class="mb-6 text-slate-600">
        Open a unit, then open a lecture to read it in your browser.
      </p>

      {% if lecture_groups %}
      <div class="space-y-4">
        {% for group in lecture_groups %}
        <details class="group rounded-2xl border border-slate-200 bg-white shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 list-none [&::-webkit-details-marker]:hidden">
            <div>
              <h3 class="text-lg font-semibold">{{ group.title }}</h3>
              {% if group.range_label %}
              <p class="mt-0.5 text-sm text-slate-500">{{ group.range_label }}</p>
              {% endif %}
            </div>
            <svg
              class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="border-t border-slate-100 px-6 pb-6 pt-5">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {% for item in group['items'] %}
              {{ card(item, 'Lecture', 'Open lecture', 'Open the lecture to read it in your browser.') }}
              {% endfor %}
            </div>
          </div>
        </details>
        {% endfor %}
      </div>
      {% else %}
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
        <h3 class="text-xl font-semibold">
          No lectures found
        </h3>

        <p class="mt-3 text-slate-600">
          Add marimo notebooks to the notebooks folder, then push your changes to GitHub.
        </p>
      </div>
      {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- PROBLEM SET SOLUTIONS (tab panel)                         -->
    <!-- Cards come from notebooks named PS<N>...py                -->
    <!-- ========================================================= -->

    <section id="problem-set-solutions" class="tab-panel scroll-mt-20 mb-20 hidden">

      <h2 class="text-2xl font-semibold mb-2">
        Problem Set Solutions
      </h2>

      <p class="mb-6 text-slate-600">
        Worked solutions to the problem sets, in the same notebook format as the lectures.
      </p>

      {% if problem_sets %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for item in problem_sets %}
        {{ card(item, 'Problem Set', 'Open problem set', 'Open the problem set to read it in your browser.') }}
        {% endfor %}
      </div>
      {% else %}
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
        <h3 class="text-xl font-semibold">
          Coming soon
        </h3>

        <p class="mt-3 text-slate-600">
          Problem set solutions will appear here as they are posted.
        </p>
      </div>
      {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- STATA TUTORIALS (tab panel)                               -->
    <!-- Cards come from notebooks named Stata<N>...py             -->
    <!-- ========================================================= -->

    <section id="stata-tutorials" class="tab-panel scroll-mt-20 mb-20 hidden">

      <h2 class="text-2xl font-semibold mb-2">
        Stata Tutorials
      </h2>

      <p class="mb-6 text-slate-600">
        Step-by-step guides to working with Stata.
      </p>

      {% if stata_tutorials %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for item in stata_tutorials %}
        {{ card(item, 'Stata Tutorial', 'Open tutorial', 'Open the tutorial to read it in your browser.') }}
        {% endfor %}
      </div>
      {% else %}
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
        <h3 class="text-xl font-semibold">
          Coming soon
        </h3>

        <p class="mt-3 text-slate-600">
          Stata tutorials will appear here as they are posted.
        </p>
      </div>
      {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- FOR STUDENTS (home view only)                             -->
    <!-- Edit this section freely                                  -->
    <!-- ========================================================= -->

    <section id="for-students" class="home-only scroll-mt-20 mb-20 max-w-3xl">
      <h2 class="text-2xl font-semibold mb-4">
        Student guide
      </h2>

      <p class="text-slate-600 leading-8">
        Resources and instructions for students will go here.
      </p>
    </section>


    <!-- ========================================================= -->
    <!-- FOR EDUCATORS (home view only)                            -->
    <!-- Edit this section freely                                  -->
    <!-- ========================================================= -->

    <section id="for-educators" class="home-only scroll-mt-20 mb-20 max-w-3xl">
      <h2 class="text-2xl font-semibold mb-4">
        For educators
      </h2>

      <p class="text-slate-600 leading-8">
        Notes for educators who want to reuse or adapt these materials will go here.
      </p>
    </section>


    <!-- ========================================================= -->
    <!-- FOOTER                                                    -->
    <!-- Edit this section to change the bottom of the website      -->
    <!-- ========================================================= -->

    <footer class="mt-16 pt-8 border-t border-slate-200 text-sm text-slate-500">
      <p>
        Built with marimo notebooks and GitHub Pages.
      </p>
    </footer>

  </main>

  <script>
    // Show the "Back to top" link only after the reader scrolls down.
    (function () {
      var btt = document.getElementById("back-to-top");
      if (!btt) return;
      function update() {
        if (window.scrollY > 120) {
          btt.classList.remove("opacity-0", "pointer-events-none");
        } else {
          btt.classList.add("opacity-0", "pointer-events-none");
        }
      }
      window.addEventListener("scroll", update, { passive: true });
      update();
    })();

    // Banner tabs: on load the home view (course description, For students,
    // For educators) is shown and every panel is hidden. Selecting a banner
    // link replaces the home view with that panel alone; clicking the active
    // link again returns to the home view. The URL hash mirrors the open
    // panel so deep links work.
    (function () {
      var TAB_IDS = ["lectures", "problem-set-solutions", "stata-tutorials"];
      var ACTIVE = ["underline", "decoration-2", "underline-offset-8", "text-[#15324f]"];
      var current = null;

      function setTab(id) {
        current = id;
        TAB_IDS.forEach(function (tabId) {
          var panel = document.getElementById(tabId);
          var link = document.querySelector('[data-tab-link="' + tabId + '"]');
          var active = tabId === id;
          if (panel) panel.classList.toggle("hidden", !active);
          if (link) {
            ACTIVE.forEach(function (cls) {
              link.classList.toggle(cls, active);
            });
          }
        });
        document.querySelectorAll(".home-only").forEach(function (el) {
          el.classList.toggle("hidden", id !== null);
        });
      }

      function openFromHash() {
        var id = window.location.hash.replace("#", "");
        if (TAB_IDS.indexOf(id) !== -1) setTab(id);
      }

      document.querySelectorAll("[data-tab-link]").forEach(function (link) {
        link.addEventListener("click", function (event) {
          event.preventDefault();
          var id = link.getAttribute("data-tab-link");
          if (current === id) {
            setTab(null);
            history.replaceState(null, "", window.location.pathname + window.location.search);
          } else {
            setTab(id);
            history.replaceState(null, "", "#" + id);
          }
        });
      });

      window.addEventListener("hashchange", openFromHash);
      openFromHash();
    })();
  </script>

</body>
</html>
